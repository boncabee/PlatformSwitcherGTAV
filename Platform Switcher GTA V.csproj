<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Grand_Theft_Auto_V_Platform_Switcher</RootNamespace>
    <AssemblyName>Platform Switcher GTA V</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Switcher.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>

    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>Platform Switcher GTA V</Product>
    <Description>Platform switcher for GTA V (GTA 5, Grand Theft Auto V) including Enhanced Edition: switch between Rockstar Games Launcher, Steam, and Epic Games using one game folder, no duplicate install. Original author TechnoStone, maintained by boncabee. MIT license.</Description>
    <Authors>boncabee; TechnoStone</Authors>
    <Copyright>Copyright (c) boncabee / TechnoStone</Copyright>
    <PackageTags>GTA V; GTA 5; Grand Theft Auto V; Enhanced Edition; platform switcher; Rockstar Games Launcher; Steam; Epic Games; one game folder; no duplicate install</PackageTags>
    <PackageProjectUrl>https://github.com/boncabee/PlatformSwitcherGTAV</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/boncabee/PlatformSwitcherGTAV</RepositoryUrl>

    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;AddToRelease\**;publish\**</DefaultItemExcludes>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\EGL.png" LogicalName="PlatformSwitcher.Assets.EGL.png" />
    <EmbeddedResource Include="Resources\RGL.png" LogicalName="PlatformSwitcher.Assets.RGL.png" />
    <EmbeddedResource Include="Resources\Steam.png" LogicalName="PlatformSwitcher.Assets.Steam.png" />
    <EmbeddedResource Include="Resources\Switcher.png" LogicalName="PlatformSwitcher.Assets.Switcher.png" />
    <EmbeddedResource Include="Switcher.ico" LogicalName="PlatformSwitcher.Assets.Switcher.ico" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PlatformSwitcher.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
